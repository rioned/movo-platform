# Copy to your process manager/secret store; never commit actual values.
NODE_ENV=production
PORT=3000
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters
JWT_EXPIRY=7d
ALLOWED_ORIGINS=https://movo.example.com
OTP_TEST_MODE=false
# Master OTP for manual testing: outside production it defaults to 000000 and
# clears every OTP prompt. Set to another 4-6 digit code, or to an empty value to
# turn it off. Setting it at all in production is a startup error.
MASTER_OTP=

# Transport and proxy
TRUST_PROXY=true
HTTPS_ONLY=true

# Observability
LOG_LEVEL=info
METRICS_TOKEN=generate-a-separate-token-for-prometheus-scraping
SHUTDOWN_GRACE_MS=10000

# Credential-attack controls
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_OTP_ATTEMPTS=5
BCRYPT_ROUNDS=12

# Rate limiting (requests per window, per caller)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_WRITE_MAX=120

# Personal-data retention
RIDER_LOCATION_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

# Providers
MAP_PROVIDER=osm
PAYMENT_PROVIDER=sandbox
SMS_PROVIDER=sandbox

# Dispatch tuning
DISPATCH_OFFER_TIMEOUT_SEC=30
DISPATCH_RADIUS_KM=5
