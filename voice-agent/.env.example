# Copy to .env and fill in real values. .env is never baked into the image
# (see .dockerignore) -- docker-compose loads it at container start.

# This host's raw public/LAN IP (never a domain name). Required: LiveKit
# uses it as the WebRTC ICE candidate address so browsers elsewhere can
# actually reach the media stream -- media negotiation needs a real IP, not
# a hostname.
NODE_IP=203.0.113.10

# What clients actually type in the browser to reach Caddy: a domain name
# for a real VPS deploy, or the same value as NODE_IP for a LAN-only test
# (no domain exists for a private IP). Caddy's automatic HTTPS uses this to
# decide what kind of certificate to get -- a real public domain here gets a
# trusted Let's Encrypt/ZeroSSL cert automatically (needs port 80 reachable
# for the ACME challenge, ongoing -- not just at first deploy, for renewal
# too); an IP address here automatically falls back to a self-signed
# internal cert instead, since public CAs won't issue for bare IPs.
PUBLIC_HOST=your-domain.example.or.same-as-NODE_IP

# Port Caddy listens on for the web UI/token/RAG API. Defaults to 8443;
# override e.g. to 8080 if that's what you're fronting.
PUBLIC_PORT=8443

# Port Caddy listens on for LiveKit signaling (WebSocket) -- deliberately a
# SEPARATE origin from PUBLIC_PORT above, with no basic_auth on it at all.
# This is required, not a simplification: browsers refuse ALL WebSocket
# connections to any origin that has ever presented an HTTP Basic-Auth
# challenge, even to a path a Caddy matcher explicitly excludes from
# basic_auth -- the restriction is enforced client-side per-origin, not
# per-path. It's still safe unauthenticated: the only way to get a valid
# LiveKit access_token is /token on PUBLIC_PORT (which IS behind the
# password), and LiveKit independently validates that JWT here regardless.
# Reuses the same cert as PUBLIC_PORT automatically (same PUBLIC_HOST).
LIVEKIT_SIGNAL_PORT=8444

# Single fixed UDP port for WebRTC media (livekit-server --udp-port) instead
# of a wide ephemeral range -- makes the cloud/VPS firewall rule a single
# port instead of a huge range. Must be open (UDP) wherever this deploys.
UDP_PORT=7882

# "dev" matches how this project was run/tested locally (verbose logs,
# auto-reload). Switch to "start" for a production worker once you've
# confirmed the stack behaves the same way under it.
AGENT_MODE=dev

# Password-gates the web UI + token/RAG API via Caddy basic_auth -- required
# before exposing this on a public VPS. Does NOT cover LIVEKIT_SIGNAL_PORT (see
# above -- can't, by design). BASIC_AUTH_HASH must be a bcrypt hash, not the
# plaintext password: generate it with
#   docker run --rm voice-agent:latest caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=muhoza
BASIC_AUTH_HASH=$2a$14$REPLACE_ME_WITH_OUTPUT_OF_caddy_hash-password

# --- LiveKit ---
# NEVER leave these as devkey/secret -- that pair is published in LiveKit's
# own docs, and entrypoint.sh passes it to livekit-server via --keys, so a
# default value here would let anyone who reaches the LiveKit port (it has
# to stay open to the internet for WebRTC media) mint their own valid
# tokens, bypassing the basic_auth password entirely. Generate a real pair:
#   docker run --rm voice-agent:latest livekit-server generate-keys
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=REPLACE_ME_SEE_COMMENT_ABOVE
LIVEKIT_API_SECRET=REPLACE_ME_SEE_COMMENT_ABOVE
# Must use LIVEKIT_SIGNAL_PORT, not PUBLIC_PORT -- see the LIVEKIT_SIGNAL_PORT comment above.
LIVEKIT_URL_PUBLIC=wss://your-domain-or-ip:8444
LIVEKIT_URL_LOCAL=ws://localhost:7880

WEB_PORT=8082

HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

WHISPER_MODEL=small.en
TTS_VOICE=en_US-lessac-medium

# Local llama-server (default, fully offline)
LLM_MODEL=qwen2.5-0.5b-instruct
LLM_BASE_URL=http://localhost:8000/v1
LLM_PROVIDER=local

# Optional external OpenAI-compatible provider (leave blank to stay local-only)
API_BASE_URL=
API_KEY=
API_MODEL=

# Optional Hermes Agent CLI provider -- NOT installed in this image; leave
# LLM_PROVIDER=local unless you extend the Dockerfile to include it.
# HERMES_TIMEOUT must stay numeric even when unused: agent.py does
# float(os.environ.get("HERMES_TIMEOUT", "90")) -- since env_file sets the
# var to an actual empty string rather than leaving it unset, an empty value
# here skips that "90" default and crashes agent.py with
# ValueError: could not convert string to float: '' (found the hard way --
# looks like a Caddy cert-issuance failure in the logs because the whole
# container crash-loops and restarts before the real cause is obvious).
HERMES_BIN=
HERMES_TIMEOUT=90
HERMES_WORKDIR=
